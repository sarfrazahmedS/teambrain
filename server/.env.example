# ---- Server ----
NODE_ENV=development
PORT=4000

# PostgreSQL (must be a pgvector-enabled instance — see docker-compose.yml)
DATABASE_URL=postgresql://teambrain:teambrain@localhost:5432/teambrain?schema=public

# JWT secrets — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret-at-least-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-16-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Where the client is served (CORS)
CLIENT_ORIGIN=http://localhost:5173

# ---- AI (optional) ----
# Leave ANTHROPIC_API_KEY empty to run in demo mode: retrieval + citations are
# real, and answers come from a built-in mock generator (no key, no cost).
# Set it to get full Claude-written answers.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ---- Embeddings (free, local — no key needed) ----
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ---- RAG tuning ----
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
RETRIEVAL_K=6
MAX_UPLOAD_MB=10
